#!/usr/bin/env bash
# gtheme — Ghostty theme switcher
# https://github.com/UnionPAC/gtheme

set -euo pipefail

VERSION="1.0.0"
THEMES_DIR="${GTHEME_DIR:-$HOME/.config/ghostty/themes}"
ACTIVE="$THEMES_DIR/active.conf"
GHOSTTY_CONFIG="$HOME/.config/ghostty/config"
REGISTRY_BASE="https://raw.githubusercontent.com/UnionPAC/gtheme/main/registry"
BINARY_URL="https://raw.githubusercontent.com/UnionPAC/gtheme/main/bin/gtheme"
VERSION_URL="https://raw.githubusercontent.com/UnionPAC/gtheme/main/VERSION"
UPDATE_CHECK_FILE="$THEMES_DIR/.gtheme_last_check"
UPDATE_NOTICE_FILE="$THEMES_DIR/.gtheme_updated"

# ── helpers ──────────────────────────────────────────────────────────────────

get_font() {
  grep -m1 '^font-family' "$1" 2>/dev/null | sed 's/font-family *= *//'
}

brew_cask_name() {
  case "$1" in
    "JetBrainsMono Nerd Font")  echo "font-jetbrains-mono-nerd-font" ;;
    "CaskaydiaCove Nerd Font")  echo "font-caskaydia-cove-nerd-font" ;;
    "FiraCode Nerd Font")       echo "font-fira-code-nerd-font" ;;
    "Hack Nerd Font")           echo "font-hack-nerd-font" ;;
    *)                          echo "" ;;
  esac
}

active_name() {
  if [[ -L "$ACTIVE" ]]; then
    basename "$(readlink "$ACTIVE")" .conf
  fi
}

font_installed() {
  local name="$1"
  local stem="${name%% Nerd*}"
  local pattern="${stem// /}"
  local dirs=()
  for d in "$HOME/Library/Fonts" "/Library/Fonts" "$HOME/.local/share/fonts" "/usr/share/fonts" "/usr/local/share/fonts"; do
    [[ -d "$d" ]] && dirs+=("$d")
  done
  [[ ${#dirs[@]} -eq 0 ]] && return 1
  find "${dirs[@]}" -maxdepth 3 -iname "*${pattern}*" 2>/dev/null | grep -q .
}

require_cmd() {
  command -v "$1" &>/dev/null || { echo "Error: '$1' is required but not installed."; exit 1; }
}

show_update_notice() {
  if [[ -f "$UPDATE_NOTICE_FILE" ]]; then
    local version
    version=$(cat "$UPDATE_NOTICE_FILE")
    echo "✓ gtheme updated to v$version"
    rm -f "$UPDATE_NOTICE_FILE"
  fi
}

auto_update() {
  # Skip if running from a symlink (developer mode)
  local self
  self="$(command -v gtheme 2>/dev/null || echo "$0")"
  [[ -L "$self" ]] && return

  # Only check once per day
  if [[ -f "$UPDATE_CHECK_FILE" ]]; then
    local last_check now
    last_check=$(cat "$UPDATE_CHECK_FILE")
    now=$(date +%s)
    (( now - last_check < 86400 )) && return
  fi

  # Background: check version, download if newer
  (
    date +%s > "$UPDATE_CHECK_FILE"
    local latest
    latest=$(curl -fsSL --max-time 3 "$VERSION_URL" 2>/dev/null | tr -d '[:space:]')
    [[ -z "$latest" || "$latest" == "$VERSION" ]] && exit 0
    local tmp
    tmp=$(mktemp)
    if curl -fsSL --max-time 10 "$BINARY_URL" -o "$tmp" 2>/dev/null; then
      chmod +x "$tmp"
      mv "$tmp" "$self"
      echo "$latest" > "$UPDATE_NOTICE_FILE"
    else
      rm -f "$tmp"
    fi
  ) &>/dev/null &
  disown
}

cmd_update() {
  local self
  self="$(command -v gtheme 2>/dev/null || echo "$0")"
  if [[ -L "$self" ]]; then
    echo "Running in developer mode (symlink detected) — skipping update."
    exit 0
  fi
  echo "Checking for updates..."
  local latest
  latest=$(curl -fsSL --max-time 5 "$VERSION_URL" 2>/dev/null | tr -d '[:space:]')
  if [[ -z "$latest" ]]; then
    echo "Could not reach update server. Check your connection."
    exit 1
  fi
  if [[ "$latest" == "$VERSION" ]]; then
    echo "Already up to date (v$VERSION)."
    exit 0
  fi
  echo "Updating v$VERSION → v$latest..."
  local tmp
  tmp=$(mktemp)
  if curl -fsSL --max-time 10 "$BINARY_URL" -o "$tmp" 2>/dev/null; then
    chmod +x "$tmp"
    mv "$tmp" "$self"
    echo "Done. gtheme is now v$latest."
  else
    rm -f "$tmp"
    echo "Update failed. Try again or re-run the installer."
    exit 1
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_list() {
  local themes=() name
  for f in "$THEMES_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .conf)"
    [[ "$name" == "active" ]] && continue
    themes+=("$name")
  done

  if [[ ${#themes[@]} -eq 0 ]]; then
    echo "No themes installed."
    echo "Browse the community registry: gtheme search"
    return
  fi

  local current selected=0 total=${#themes[@]}
  current="$(active_name)"
  for i in "${!themes[@]}"; do
    [[ "${themes[$i]}" == "$current" ]] && selected=$i
  done

  local old_stty
  old_stty="$(stty -g)"

  _restore_term() { stty "$old_stty"; printf "\033[?25h"; }
  trap '_restore_term' EXIT INT TERM

  stty -echo -icanon min 1 time 0
  printf "\033[?25l"

  local first_draw=1
  _draw() {
    if [[ "$first_draw" -eq 0 ]]; then printf "\033[%dA" "$((total + 1))"; fi
    first_draw=0
    printf "\r\033[K\033[2m  ↑↓ navigate · enter select · q cancel\033[0m\n"
    local i suffix
    for i in "${!themes[@]}"; do
      suffix=""
      [[ "${themes[$i]}" == "$current" ]] && suffix="  (active)"
      if [[ "$i" -eq "$selected" ]]; then
        printf "\r\033[K\033[1;36m› %s%s\033[0m\n" "${themes[$i]}" "$suffix"
      else
        printf "\r\033[K  %s%s\n" "${themes[$i]}" "$suffix"
      fi
    done
  }

  _draw

  local key key2 key3
  while true; do
    IFS= read -r -s -n1 key || true
    if [[ "$key" == $'\x1b' ]]; then
      IFS= read -r -s -n1 -t 1 key2 || true
      if [[ "${key2:-}" == "[" ]]; then
        IFS= read -r -s -n1 -t 1 key3 || true
        case "${key3:-}" in
          A) if [[ $selected -gt 0 ]]; then selected=$(( selected - 1 )); fi ;;
          B) if [[ $selected -lt $((total - 1)) ]]; then selected=$(( selected + 1 )); fi ;;
        esac
      else
        break
      fi
    elif [[ "$key" == $'\r' || "$key" == $'\n' || "$key" == "" ]]; then
      trap - EXIT INT TERM
      _restore_term
      printf "\n"
      cmd_switch "${themes[$selected]}"
      return
    elif [[ "$key" == "q" || "$key" == "Q" ]]; then
      break
    fi
    _draw
  done

  trap - EXIT INT TERM
  _restore_term
  printf "\n"
}

cmd_switch() {
  local name="$1"
  local target="$THEMES_DIR/$name.conf"

  if [[ "$(active_name)" == "$name" ]]; then
    echo "Already using: $name"
    exit 0
  fi

  ln -sf "$target" "$ACTIVE"

  local font cask
  font="$(get_font "$target")"
  cask="$(brew_cask_name "$font")"

  echo "Switched to: $name"
  if [[ -n "$font" ]] && ! font_installed "$font"; then
    [[ -n "$cask" ]] && echo "⚠  Font not installed: brew install --cask $cask"
  fi
  echo "Reload Ghostty: cmd + shift + ,"
}

cmd_search() {
  local url="https://unionpac.github.io/gtheme"
  echo "Opening community themes in your browser..."
  echo "URL: $url"
  if command -v open &>/dev/null; then
    open "$url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$url"
  else
    echo "Open the URL above in your browser to browse themes."
  fi
}

cmd_add() {
  require_cmd curl
  local name="$1"
  local target="$THEMES_DIR/$name.conf"

  local reserved="list search add remove update uninstall submit version help"
  for word in $reserved; do
    if [[ "$name" == "$word" ]]; then
      echo "Error: '$name' is a reserved command name and cannot be used as a theme name."
      exit 1
    fi
  done

  if [[ -f "$target" ]]; then
    echo "Theme '$name' is already installed."
    exit 0
  fi

  echo "Fetching '$name' from registry..."
  local url="$REGISTRY_BASE/themes/$name.conf"

  if ! curl -fsSL "$url" -o "$target" 2>/dev/null; then
    rm -f "$target"
    echo "Error: theme '$name' not found in registry."
    echo "Browse community themes: https://unionpac.github.io/gtheme"
    exit 1
  fi

  local font cask
  font="$(get_font "$target")"
  cask="$(brew_cask_name "$font")"

  echo "Installed: $name"
  if [[ -n "$font" ]] && ! font_installed "$font"; then
    [[ -n "$cask" ]] && echo "⚠  Font not installed: brew install --cask $cask"
  fi
  echo "Activate with: gtheme $name"
}

cmd_remove() {
  local name="$1"
  local target="$THEMES_DIR/$name.conf"

  if [[ ! -f "$target" ]]; then
    echo "Theme '$name' is not installed."
    exit 1
  fi

  if [[ "$(active_name)" == "$name" ]]; then
    echo "Error: '$name' is currently active. Switch to another theme first."
    exit 1
  fi

  rm "$target"
  echo "Removed: $name"
}

cmd_version() {
  echo "gtheme v$VERSION"
}

cmd_uninstall() {
  local self
  self="$(command -v gtheme 2>/dev/null || echo "$0")"

  echo "This will remove:"
  echo "  - gtheme binary ($self)"
  echo "  - Bundled themes from $THEMES_DIR"
  echo "  - active.conf symlink"
  echo "  - gtheme line from Ghostty config"
  echo "  - gtheme PATH entry from shell config files"
  echo ""

  # Warn about community themes that would be left behind
  local extras=()
  local bundled="synthwave-noir ocean-depths ember-ash forest-dark"
  for f in "$THEMES_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .conf)"
    [[ "$name" == "active" ]] && continue
    echo "$bundled" | grep -qw "$name" || extras+=("$name")
  done
  if [[ ${#extras[@]} -gt 0 ]]; then
    echo "Community themes will NOT be removed (delete manually if wanted):"
    for t in "${extras[@]}"; do echo "  $THEMES_DIR/$t.conf"; done
    echo ""
  fi

  read -r -p "Uninstall gtheme? [y/N] " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
  echo ""

  # Bundled themes + active symlink + update state files
  for theme in synthwave-noir ocean-depths ember-ash forest-dark; do
    rm -f "$THEMES_DIR/$theme.conf"
  done
  rm -f "$ACTIVE" "$UPDATE_CHECK_FILE" "$UPDATE_NOTICE_FILE"
  echo "  - removed bundled themes and active symlink"

  # Remove config-file line from Ghostty config
  if [[ -f "$GHOSTTY_CONFIG" ]] && grep -q "themes/active\.conf" "$GHOSTTY_CONFIG"; then
    local tmp
    tmp=$(mktemp)
    grep -v "themes/active\.conf" "$GHOSTTY_CONFIG" > "$tmp" || true
    mv "$tmp" "$GHOSTTY_CONFIG"
    echo "  - cleaned Ghostty config"
  fi

  # Remove PATH entry from shell rc files
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile"; do
    if [[ -f "$rc" ]] && grep -qE '\.local/bin' "$rc"; then
      local tmp
      tmp=$(mktemp)
      grep -v "# Added by gtheme installer" "$rc" \
        | grep -v 'export PATH=.*\.local/bin' > "$tmp" \
        && mv "$tmp" "$rc"
      echo "  - cleaned PATH from $rc"
    fi
  done

  # Remove binary last
  rm -f "$self"
  echo "  - removed gtheme binary"

  echo ""
  echo "gtheme has been uninstalled. Open a new terminal to clear the PATH."
}

cmd_submit() {
  local url="https://github.com/UnionPAC/gtheme/issues/new?template=submit-theme.yml"
  echo "Opening theme submission form in your browser..."
  echo ""
  echo "Fill out the form and we'll add your theme to the registry."
  echo "URL: $url"
  echo ""
  if command -v open &>/dev/null; then
    open "$url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$url"
  else
    echo "Open the URL above in your browser to submit."
  fi
}

cmd_help() {
  cat <<EOF
gtheme — Ghostty theme switcher

Usage:
  gtheme list                  Browse and switch themes (interactive)
  gtheme <name>                Switch directly to a named theme
  gtheme search                Browse the community registry (opens browser)
  gtheme add <name>            Install a theme from the registry
  gtheme remove <name>         Remove an installed theme
  gtheme update                Update gtheme to the latest version
  gtheme uninstall             Remove gtheme from your system
  gtheme submit                Share your theme with the community
  gtheme version               Show the current version
  gtheme help                  Show all commands and usage
EOF
echo ""
}

# ── startup ──────────────────────────────────────────────────────────────────

# Warn if active symlink points to a deleted theme
if [[ -L "$ACTIVE" && ! -f "$ACTIVE" ]]; then
  echo "⚠  Active theme is missing — run 'gtheme list' and switch to a valid theme."
fi

show_update_notice
auto_update

# ── router ───────────────────────────────────────────────────────────────────

case "${1:-}" in
  list)              cmd_list ;;
  search)            cmd_search ;;
  add)               [[ -z "${2:-}" ]] && { echo "Usage: gtheme add <name>"; exit 1; }; cmd_add "$2" ;;
  remove|rm)         [[ -z "${2:-}" ]] && { echo "Usage: gtheme remove <name>"; exit 1; }; cmd_remove "$2" ;;
  update)            cmd_update ;;
  uninstall)         cmd_uninstall ;;
  version|--version) cmd_version ;;
  submit)            cmd_submit ;;
  help|--help|-h)    cmd_help ;;
  "")                cmd_help ;;
  *)
    if [[ -f "$THEMES_DIR/$1.conf" ]]; then
      cmd_switch "$1"
    else
      echo "Unknown command: '$1'. Run 'gtheme help' to see available commands."
      exit 1
    fi
    ;;
esac
